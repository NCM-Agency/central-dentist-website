---
// Header.astro - Site header with navigation
import Navigation from './Navigation.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;
---

<header class="w-full sticky top-0 z-50" data-gjs-type="header">
  <!-- Utility Bar - Desktop Only -->
  <div class="hidden lg:block bg-gradient-to-r from-[#006786] to-[#0099ba] text-white">
    <div class="container mx-auto container-padding">
      <div class="flex items-center justify-between h-9 text-sm">
        <div class="flex items-center space-x-4">
          <a href="tel:214-368-0900" class="flex items-center space-x-1.5 hover:text-white/80 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-semibold">(214) 368-0900</span>
          </a>
          <span class="text-white/40">|</span>
          <span class="text-white/80">10210 N Central Expy, Ste 100, Dallas, TX</span>
        </div>
        <a
          href="/contact"
          class="px-5 py-1 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-medium text-xs hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg transition-all duration-300"
          style="font-family: 'Playfair Display', 'Times', serif;"
        >
          Schedule Visit
        </a>
      </div>
    </div>
  </div>
  <Navigation currentPath={currentPath} />
</header>