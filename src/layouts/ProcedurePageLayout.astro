---
// ProcedurePageLayout.astro - Template for surgical/procedure post-op care pages
import Layout from './Layout.astro';
import PageHero from '../components/shared/PageHero.astro';
import BlurFade from '../components/ui/BlurFade.astro';

export interface Props {
  title: string;
  categoryTitle: string;
  overview: string;
  postOperativeCare: string[];
  dietAndActivity: string[];
  oralHygiene: string[];
  holisticSupport: string[];
  whenToContact: string;
  followUp: string;
}

const {
  title,
  categoryTitle,
  overview,
  postOperativeCare,
  dietAndActivity,
  oralHygiene,
  holisticSupport,
  whenToContact,
  followUp
} = Astro.props;

const careCards = [
  {
    title: 'Immediate Post-Operative Care',
    items: postOperativeCare,
    iconColor: 'linear-gradient(to bottom right, #0099ba, #006786)',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`
  },
  {
    title: 'Diet & Activity',
    items: dietAndActivity,
    iconColor: 'linear-gradient(to bottom right, #0099ba, #006786)',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />`
  },
  {
    title: 'Oral Hygiene',
    items: oralHygiene,
    iconColor: 'linear-gradient(to bottom right, #0099ba, #006786)',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`
  },
  {
    title: 'Holistic & Natural Support',
    items: holisticSupport,
    iconColor: 'linear-gradient(to bottom right, #a6b443, #c7cd85)',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`
  }
];
---

<Layout
  title={`${title} — Post-Op Care | Central Dentist Dallas`}
  description={`Post-operative care instructions for ${title} at Central Dentist Dallas. Holistic recovery guidance for optimal healing.`}
  schemaType="MedicalBusiness"
>
  <!-- Hero Section -->
  <PageHero
    title={title}
    subtitle="Post-Operative Care Instructions"
    backgroundImage="/images/services/abstract-white-texture.jpg"
    variant="standard"
    breadcrumbs={[
      { label: 'Procedures', href: '/surgical' },
      { label: title, href: '#' }
    ]}
  />

  <!-- Overview Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <BlurFade delay={100} client:visible>
          <div class="flex items-center gap-3 mb-6">
            <span class="px-3 py-1 rounded-full text-sm font-medium text-white"
                  style="background: linear-gradient(to right, #0099ba, #006786);">
              {categoryTitle}
            </span>
          </div>
          <p class="text-lg leading-relaxed" style="color: #4b5563; font-family: 'Geist', sans-serif;">
            {overview}
          </p>
        </BlurFade>
      </div>
    </div>
  </section>

  <!-- Care Instructions - 2x2 Card Grid -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <BlurFade delay={100} client:visible>
          <h2 class="text-3xl md:text-4xl font-normal text-center mb-4"
              style="font-family: 'Playfair Display', serif; color: #006786;">
            Post-Procedure Care
          </h2>
          <p class="text-center text-lg mb-12" style="color: #6b7280; font-family: 'Geist', sans-serif;">
            Follow these guidelines to support your recovery and healing
          </p>
        </BlurFade>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {careCards.map((card, index) => (
            <BlurFade delay={200 + (index * 100)} client:visible>
              <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-gray-100 h-full">
                <!-- Card Header -->
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                       style={`background: ${card.iconColor};`}>
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={card.icon} />
                  </div>
                  <h3 class="text-xl font-semibold" style="font-family: 'Playfair Display', serif; color: #006786;">
                    {card.title}
                  </h3>
                </div>

                <!-- Bullet Items -->
                <ul class="space-y-4">
                  {card.items.map((item) => (
                    <li class="flex items-start">
                      <div class="w-5 h-5 rounded flex items-center justify-center mr-3 mt-0.5 flex-shrink-0"
                           style="background: linear-gradient(to bottom right, #a6b443, #c7cd85);">
                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <span class="text-sm leading-relaxed" style="color: #4b5563; font-family: 'Geist', sans-serif;">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </BlurFade>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- When to Contact + Follow-Up Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto space-y-8">
        <!-- When to Contact -->
        <BlurFade delay={100} client:visible>
          <div class="bg-amber-50 border-l-4 border-amber-400 rounded-r-xl p-6 md:p-8">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-amber-100">
                <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2" style="font-family: 'Playfair Display', serif; color: #92400e;">
                  When to Contact Our Office
                </h3>
                <p class="leading-relaxed" style="color: #78350f; font-family: 'Geist', sans-serif;">
                  {whenToContact}
                </p>
              </div>
            </div>
          </div>
        </BlurFade>

        <!-- Follow-Up -->
        <BlurFade delay={200} client:visible>
          <div class="border-l-4 rounded-r-xl p-6 md:p-8" style="background-color: #f0f7f9; border-color: #0099ba;">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background-color: #e0f0f5;">
                <svg class="w-6 h-6" style="color: #0099ba;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2" style="font-family: 'Playfair Display', serif; color: #006786;">
                  Follow-Up Appointment
                </h3>
                <p class="leading-relaxed" style="color: #4b5563; font-family: 'Geist', sans-serif;">
                  {followUp}
                </p>
              </div>
            </div>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <BlurFade delay={100} client:visible>
          <h2 class="text-4xl md:text-5xl font-normal text-white mb-4"
              style="font-family: 'Playfair Display', serif;">
            Have Questions About Your Procedure?
          </h2>
        </BlurFade>

        <BlurFade delay={200} client:visible>
          <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
            Our team is here to support your recovery and answer any concerns
          </p>
        </BlurFade>

        <BlurFade delay={300} client:visible>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif;"
            >
              Schedule Consultation
            </a>
            <a
              href="tel:214-368-0900"
              class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
              onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
              onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
            >
              <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call (214) 368-0900
            </a>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>
</Layout>
