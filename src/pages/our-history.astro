---
// Our History Page - Central Dentist
import AboutPageTemplate from '../layouts/AboutPageTemplate.astro';
import BlurFade from '../components/ui/BlurFade.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
---

<AboutPageTemplate
  title="Our History | Central Dentist Dallas | Holistic Dentistry Since 1981"
  description="Learn about Central Dentist's four generations of family dentistry and our 40+ year history of holistic dental care in Dallas."
  heroTitle="Our History"
  heroSubtitle="Four Generations of Family Dentistry Excellence"
  breadcrumbs={[
    { label: 'About', href: '/our-office' },
    { label: 'Our History', href: '/our-history' }
  ]}
  schemaType="MedicalBusiness"
>

  <!-- Our Story Section -->
  <section slot="philosophy" class="about-section bg-white">
    <div class="container mx-auto container-padding">
      <div class="max-w-4xl mx-auto">
        <BlurFade delay={100} client:visible>
          <h2 class="font-heading text-h2 font-semibold text-gray-dark mb-8">
            A Legacy of Natural Dental Care
          </h2>
        </BlurFade>

        <BlurFade delay={200} client:visible>
          <div class="prose prose-lg max-w-none mb-12">
            <p class="font-body text-lg text-gray-medium leading-relaxed mb-6">
              Four generations of family dentistry has led us to where Central Dentist is today. For us, it is
              more than a chosen profession, it is a passion. The importance of a positive dental and health
              experience has been ingrained in our culture, and we strive to treat every patient with the same
              compassion and care that we would if they were a part of our own family.
            </p>

            <p class="font-body text-lg text-gray-medium leading-relaxed mb-6">
              We are honored to take care of multiple generations of families, from the elderly who may be in
              nursing homes, to children as young as 6-12 months old, to the parents and family members who
              hold it all together in between.
            </p>

            <p class="font-body text-lg text-gray-medium leading-relaxed mb-6">
              Central Dentist was founded in 1981 with a revolutionary vision: to provide dental care that
              considers the whole person, not just their teeth. Our founders recognized early on that oral
              health is intrinsically connected to overall wellness, and that the materials and methods used
              in dentistry can have far-reaching effects on the body.
            </p>

            <p class="font-body text-lg text-gray-medium leading-relaxed mb-6">
              We were among the first practices in Dallas to eliminate mercury amalgam fillings, understanding
              the potential health risks long before it became mainstream knowledge. This pioneering spirit has
              guided our practice for over four decades, always seeking safer, more biocompatible alternatives
              to traditional dental materials.
            </p>
          </div>
        </BlurFade>

        <!-- Family Legacy Drawing -->
        <BlurFade delay={300} client:visible>
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 text-center">
            <h3 class="font-heading text-xl md:text-2xl font-semibold mb-6" style="color: #006786;">
              Four Generations of Family Dentistry
            </h3>
            <img
              src="/images/history/rosellini-family-legacy.png"
              alt="Four generations of the Rosellini family in dentistry — Dr. Frank Bourgeois (1928), Dr. Forrest 'Doc' Rosellini (1953), Dr. Michael Rosellini (1980), Dr. Jill Rosellini Ombrello (2007), and Dr. Beth Rosellini (2011)"
              class="w-full max-w-3xl mx-auto rounded-lg shadow-md"
              loading="lazy"
            />
            <p class="font-body text-sm text-gray-500 mt-4 italic">
              From Tulane School of Dentistry in 1928 to Central Dentist today — a family tradition of compassionate care
            </p>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>

  <!-- Meet Our Team Section -->
  <section slot="team" class="about-section bg-gray-50">
    <div class="container mx-auto container-padding">
      <div class="max-w-6xl mx-auto">
        <BlurFade delay={100} client:visible>
          <h2 class="text-section-header text-header-primary text-center mb-12">
            Meet Our Team
          </h2>
        </BlurFade>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <!-- Dr. Jill Ombrello -->
          <BlurFade delay={200} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/dr-ombrello.jpg"
                alt="Dr. Jill Rosellini Ombrello"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Dr. Jill Rosellini Ombrello</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">DDS, AIAOMT</p>
                <p class="text-sm text-gray-medium mb-4">
                  Holistic Family Dentist, Special Needs Patient Advocate. Focuses her general dentistry
                  practice on sleep health, airway management, and early interventional growth & development
                  services, collaborating with Pediatricians & ENT Physicians.
                </p>
                <a
                  href="/team/dr-jill-ombrello"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>

          <!-- Dr. Elizabeth Alejandrez -->
          <BlurFade delay={300} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/dr-alejandrez.jpg"
                alt="Dr. Elizabeth Alejandrez"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Dr. Elizabeth Alejandrez</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">DMD</p>
                <p class="text-sm text-gray-medium mb-4">
                  Associate Doctor providing comprehensive family care, Invisalign services, airway-focused
                  health, and a whole-body approach to oral wellness.
                </p>
                <a
                  href="/team/dr-elizabeth-alejandrez"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>

          <!-- Dr. Sahil Sawnani -->
          <BlurFade delay={400} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/dr-sawnani.jpg"
                alt="Dr. Sahil Sawnani"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Dr. Sahil Sawnani</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">DDS, IAOMT, AAID</p>
                <p class="text-sm text-gray-medium mb-4">
                  A compassionate, biological dental provider who combines advanced clinical expertise
                  with personalized, whole-body care.
                </p>
                <a
                  href="/team/dr-sahil-sawnani"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-16">
          <!-- Lakisha Merrick -->
          <BlurFade delay={500} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/lakisha-merrick.jpg"
                alt="Lakisha Merrick"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Lakisha Merrick</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">Chief Operating Officer</p>
                <p class="text-sm text-gray-medium mb-4">
                  Leading our operations and ensuring every patient receives an exceptional experience from the moment they contact our office.
                </p>
                <a
                  href="/team/lakisha-merrick"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>

          <!-- Jaclyn Altman -->
          <BlurFade delay={600} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/jaclyn-altman.jpg"
                alt="Jaclyn Altman, RDH"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Jaclyn Altman</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">RDH, Registered Dental Hygienist</p>
                <p class="text-sm text-gray-medium mb-4">
                  Over 22 years of experience with a focus on holistic dental care, laser dentistry, and myofunctional therapy.
                </p>
                <a
                  href="/team/jaclyn-altman"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>

          <!-- Ginny Allen -->
          <BlurFade delay={700} client:visible>
            <Card className="h-full overflow-hidden">
              <img
                src="/images/team/ginny-allen.jpg"
                alt="Ginny Allen"
                class="w-full h-64 object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-semibold mb-2">Ginny Allen</h3>
                <p class="text-sm font-semibold mb-3" style="color: #0099ba;">Marketing and Patient Communications Specialist</p>
                <p class="text-sm text-gray-medium mb-4">
                  With 31+ years in dentistry, Ginny is the friendly voice and connection-maker who keeps patient communication clear and personal.
                </p>
                <a
                  href="/team/ginny-allen"
                  class="inline-flex items-center text-sm font-semibold"
                  style="color: #0099ba;"
                >
                  Learn More
                  <svg aria-hidden="true" focusable="false" class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Card>
          </BlurFade>
        </div>

        <!-- Milestones Timeline -->
        <BlurFade delay={100} client:visible>
          <h2 class="text-section-header text-header-primary text-center mb-12">
            Our Journey Through the Years
          </h2>
        </BlurFade>

        <div class="space-y-8">
          <BlurFade delay={200} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">2009 - The Beginning</h3>
              <p class="font-body text-gray-medium">
                Central Dentist opens its doors with a commitment to mercury-free dentistry and holistic patient care.
              </p>
            </div>
          </BlurFade>

          <BlurFade delay={300} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">2012 - Biocompatibility Testing</h3>
              <p class="font-body text-gray-medium">
                We become one of the first practices in Texas to offer biocompatibility testing for dental materials,
                ensuring each patient receives materials that work best with their individual biology.
              </p>
            </div>
          </BlurFade>

          <BlurFade delay={400} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">2012 - SMART Protocol Adoption</h3>
              <p class="font-body text-gray-medium">
                Early adoption of the Safe Mercury Amalgam Removal Technique (SMART) protocol, protecting patients
                and staff during amalgam removal procedures.
              </p>
            </div>
          </BlurFade>

          <BlurFade delay={500} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">2015 - Advanced Technology Integration</h3>
              <p class="font-body text-gray-medium">
                Introduction of digital dentistry with 3D imaging, allowing for more precise diagnostics and
                treatment planning while reducing radiation exposure.
              </p>
            </div>
          </BlurFade>

          <BlurFade delay={600} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">2020 - Ozone Therapy & PRF</h3>
              <p class="font-body text-gray-medium">
                Expansion of our biological dentistry services with ozone therapy and Platelet Rich Fibrin (PRF),
                offering natural healing and infection control options.
              </p>
            </div>
          </BlurFade>

          <BlurFade delay={700} client:visible>
            <div class="bg-white rounded-lg p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-semibold mb-4" style="color: #0099ba;">Today - Continuing Our Holistic Approach</h3>
              <p class="font-body text-gray-medium">
                With our recent practice expansion, CBCT technology, and comprehensive holistic services, we continue
                our commitment to safe, natural dental care while maintaining the personal touch that has defined us
                for over 40 years.
              </p>
            </div>
          </BlurFade>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section slot="services" class="about-section bg-white">
    <div class="container mx-auto container-padding">
      <div class="max-w-4xl mx-auto">
        <BlurFade delay={100} client:visible>
          <h2 class="font-heading text-h2 font-semibold text-gray-dark mb-8 text-center">
            Our Enduring Values
          </h2>
        </BlurFade>

        <BlurFade delay={200} client:visible>
          <div class="prose prose-lg max-w-none">
            <p class="font-body text-lg text-gray-medium leading-relaxed mb-6">
              Throughout our history, certain principles have remained constant:
            </p>

            <ul class="space-y-4 mb-8">
              <li class="flex items-start">
                <span class="text-2xl mr-3" style="color: #a6b443;">✓</span>
                <span class="font-body text-gray-medium">
                  <strong>First, Do No Harm:</strong> Every treatment decision prioritizes your overall health
                </span>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3" style="color: #a6b443;">✓</span>
                <span class="font-body text-gray-medium">
                  <strong>Education Empowers:</strong> We believe informed patients make the best health decisions
                </span>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3" style="color: #a6b443;">✓</span>
                <span class="font-body text-gray-medium">
                  <strong>Innovation with Purpose:</strong> We adopt new technologies that genuinely improve patient outcomes
                </span>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3" style="color: #a6b443;">✓</span>
                <span class="font-body text-gray-medium">
                  <strong>Personalized Care:</strong> Every patient is unique, and their treatment should be too
                </span>
              </li>
            </ul>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section slot="cta" class="py-16 md:py-20" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <BlurFade delay={100} client:load>
          <h2 class="text-4xl md:text-5xl font-normal text-white mb-4"
              style="font-family: 'Playfair Display', serif;">
            Continue Our Journey Together
          </h2>
        </BlurFade>

        <BlurFade delay={200} client:load>
          <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
            Join the thousands of Dallas families who have trusted us with their holistic dental care for over four decades
          </p>
        </BlurFade>

        <BlurFade delay={300} client:load>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/appointment"
              class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif;"
            >
              Schedule Your Visit
            </a>
            <a
              href="tel:214-368-0900"
              class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
              onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
              onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
            >
              <svg aria-hidden="true" focusable="false" class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call Now: (214) 368-0900
            </a>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>

</AboutPageTemplate>