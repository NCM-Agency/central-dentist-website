---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import BlurFade from '../../components/ui/BlurFade.astro';
import proceduresData from '../../content/procedures.json';

const categories = proceduresData.categories;
const procedures = proceduresData.procedures;

// Category icons (inline SVG paths)
const categoryIcons: Record<string, string> = {
  surgical: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  restorative: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`,
  cosmetic: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`,
  sleep: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />`
};

const categoryColors: Record<string, string> = {
  surgical: '#0099ba',
  restorative: '#006786',
  cosmetic: '#a6b443',
  sleep: '#8b5cf6'
};
---

<Layout
  title="Procedures & Post-Op Care | Central Dentist Dallas"
  description="Comprehensive post-operative care instructions for dental procedures at Central Dentist Dallas. Holistic recovery guidance for surgical, restorative, cosmetic, and sleep treatments."
  schemaType="MedicalBusiness"
>
  <!-- Hero Section -->
  <PageHero
    title="Procedures & Post-Op Care"
    subtitle="Comprehensive care instructions for your dental procedures"
    backgroundImage="/images/services/abstract-white-texture.jpg"
    variant="standard"
    breadcrumbs={[
      { label: 'Procedures', href: '#' }
    ]}
  />

  <!-- Category Overview Cards -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <BlurFade delay={100} client:visible>
          <h2 class="text-3xl md:text-4xl font-normal text-center mb-4"
              style="font-family: 'Playfair Display', serif; color: #006786;">
            Our Procedures
          </h2>
          <p class="text-center text-lg mb-12 max-w-2xl mx-auto" style="color: #6b7280; font-family: 'Geist', sans-serif;">
            Select a category to view procedures and their holistic post-operative care instructions
          </p>
        </BlurFade>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {categories.map((category, index) => {
            const count = procedures.filter(p => p.category === category.id).length;
            return (
              <BlurFade delay={200 + (index * 100)} client:visible>
                <a href={`#${category.id}`}
                   class="block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border border-gray-100 group hover:-translate-y-1 text-center">
                  <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4 transition-transform duration-300 group-hover:scale-110"
                       style={`background: linear-gradient(to bottom right, ${categoryColors[category.id]}, ${categoryColors[category.id]}dd);`}>
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[category.id]} />
                  </div>
                  <h3 class="text-lg font-semibold mb-1" style="font-family: 'Playfair Display', serif; color: #006786;">
                    {category.title}
                  </h3>
                  <p class="text-sm" style="color: #6b7280; font-family: 'Geist', sans-serif;">
                    {count} {count === 1 ? 'procedure' : 'procedures'}
                  </p>
                </a>
              </BlurFade>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Category Sections -->
  {categories.map((category, catIndex) => {
    const categoryProcedures = procedures.filter(p => p.category === category.id);
    const bgClass = catIndex % 2 === 0 ? 'bg-gray-50' : 'bg-white';
    return (
      <section id={category.id} class={`py-16 md:py-20 ${bgClass}`}>
        <div class="container mx-auto px-4 md:px-6">
          <div class="max-w-5xl mx-auto">
            <BlurFade delay={100} client:visible>
              <div class="flex items-center gap-4 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center"
                     style={`background: linear-gradient(to bottom right, ${categoryColors[category.id]}, ${categoryColors[category.id]}dd);`}>
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[category.id]} />
                </div>
                <h2 class="text-3xl md:text-4xl font-normal"
                    style="font-family: 'Playfair Display', serif; color: #006786;">
                  {category.title}
                </h2>
              </div>
              <p class="text-lg mb-10" style="color: #6b7280; font-family: 'Geist', sans-serif;">
                {category.description}
              </p>
            </BlurFade>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {categoryProcedures.map((procedure, index) => (
                <BlurFade delay={200 + (index * 100)} client:visible>
                  <a href={`/surgical/${procedure.slug}`}
                     class="block bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border border-gray-100 group hover:-translate-y-1 h-full">
                    <h3 class="text-lg font-semibold mb-3 group-hover:underline" style="font-family: 'Playfair Display', serif; color: #006786;">
                      {procedure.title}
                    </h3>
                    <p class="text-sm leading-relaxed mb-4" style="color: #6b7280; font-family: 'Geist', sans-serif;">
                      {procedure.shortDescription}
                    </p>
                    <span class="inline-flex items-center text-sm font-medium transition-colors"
                          style="color: #0099ba;">
                      View Instructions
                      <svg class="ml-1 w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                </BlurFade>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- CTA Section -->
  <section class="py-16 md:py-20" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <BlurFade delay={100} client:visible>
          <h2 class="text-4xl md:text-5xl font-normal text-white mb-4"
              style="font-family: 'Playfair Display', serif;">
            Ready to Schedule Your Procedure?
          </h2>
        </BlurFade>

        <BlurFade delay={200} client:visible>
          <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
            Our holistic team is here to guide you through every step of your care
          </p>
        </BlurFade>

        <BlurFade delay={300} client:visible>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif;"
            >
              Schedule Consultation
            </a>
            <a
              href="tel:214-368-0900"
              class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
              style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
              onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
              onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
            >
              <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call (214) 368-0900
            </a>
          </div>
        </BlurFade>
      </div>
    </div>
  </section>
</Layout>
