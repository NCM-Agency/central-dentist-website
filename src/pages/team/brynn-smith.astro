---
// Brynn Smith - Central Dentist
import TeamMemberTemplate from '../../layouts/TeamMemberTemplate.astro';
import BlurFade from '../../components/ui/BlurFade.astro';
---

<TeamMemberTemplate
  title="Brynn Smith, RDH | Lead Dental Hygienist | Central Dentist"
  description="Meet Brynn Smith, RDH, Lead Dental Hygienist at Central Dentist in Dallas, TX, with certifications in laser dentistry, local anesthesia, and biological dentistry through IABDM."
  memberName="Brynn Smith"
  credentials="RDH"
  role="Lead Dental Hygienist"
  imageUrl="/images/team/brynn-smith.jpg"
  breadcrumbs={[
    { label: 'Team', href: '/team' },
    { label: 'Brynn Smith', href: '/team/brynn-smith' }
  ]}
>
  <div slot="biography" class="bio-content">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 400; color: #006786; margin-bottom: 1rem;">About Brynn</h3>
    <p>Brynn Smith serves as Lead Dental Hygienist at Central Dentist, bringing a passion for clinical excellence, patient education, and an integrative approach to oral and whole-body wellness. She earned her Bachelor of Science in Dental Hygiene from Texas A&amp;M College of Dentistry in Dallas and holds advanced certifications in laser dentistry, local anesthesia, and biological dentistry through the International Academy of Biological Dentistry &amp; Medicine (IABDM).</p>

    <p>In her leadership role, Brynn is dedicated to advancing clinical standards, guiding the hygiene team, and ensuring an exceptional patient experience. She is especially passionate about making oral health education accessible by developing informative resources and videos that help patients better understand periodontal health, preventive care, and treatment options. Her commitment to innovation and personalized care empowers patients to make informed decisions about their long-term health.</p>
  </div>

  <div slot="education" class="member-section bg-gray-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Certifications & Training</h3>
    <ul class="space-y-3 text-gray-600">
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Registered Dental Hygienist (RDH)</strong> - Bachelor of Science in Dental Hygiene, Texas A&amp;M College of Dentistry</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Laser Dentistry Certification</strong> - Advanced training in laser techniques</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Local Anesthesia Certification</strong> - Advanced training in patient comfort and care</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>IABDM Certification</strong> - International Academy of Biological Dentistry &amp; Medicine</span>
      </li>
    </ul>
  </div>

  <div slot="specialties" class="member-section mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Areas of Expertise</h3>
    <ul class="space-y-3 text-gray-600">
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Holistic and biological dental hygiene practices</span></li>
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Laser-assisted periodontal therapy</span></li>
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Periodontal disease prevention and management</span></li>
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Integrative approaches to oral and whole-body health</span></li>
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Patient education and preventive care</span></li>
      <li class="flex items-start"><span class="text-green-500 mr-2">•</span><span>Hygiene team leadership and clinical excellence</span></li>
    </ul>
  </div>

  <div slot="philosophy" class="member-section bg-green-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Personal Touch</h3>
    <p class="text-gray-700">Outside of dentistry, Brynn enjoys spending time with her husband and son, embracing the joys of family life. Her ideal day off includes sleeping in, getting in a good workout, enjoying a big brunch, and relaxing at home. Known for her upbeat personality and encouraging spirit, Brynn loves helping others feel confident and cared for. She lives by the words, "Never let a problem to be solved become greater than a person to be loved," a philosophy that reflects the compassion she brings to both her personal life and patient care.</p>
  </div>

  <div slot="certifications" class="member-section bg-gray-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem; text-align: center;">Professional Affiliations</h3>
    <div class="flex flex-wrap justify-center gap-2">
      <span class="certification-badge">American Dental Hygienists' Association (ADHA)</span>
      <span class="certification-badge">Texas Dental Hygienists' Association (TDHA)</span>
      <span class="certification-badge">Academy of Laser Dentistry (ALD)</span>
      <span class="certification-badge">International Academy of Biological Dentistry &amp; Medicine (IABDM)</span>
    </div>
  </div>

  <section slot="cta" class="py-12 md:py-16" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <BlurFade delay={100} client:load>
        <h2 class="text-3xl md:text-4xl font-normal text-white mb-4"
            style="font-family: 'Playfair Display', serif;">
          Schedule Your Cleaning with Brynn
        </h2>
      </BlurFade>

      <BlurFade delay={200} client:load>
        <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
          Holistic dental hygiene with a focus on prevention and patient education
        </p>
      </BlurFade>

      <BlurFade delay={300} client:load>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif;"
          >
            Book Your Cleaning
          </a>
          <a
            href="tel:214-368-0900"
            class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
            onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
            onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
          >
            <svg aria-hidden="true" focusable="false" class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Now: (214) 368-0900
          </a>
        </div>
      </BlurFade>
    </div>
  </section>

</TeamMemberTemplate>
