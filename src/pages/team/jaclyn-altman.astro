---
// Jaclyn Altman - Central Dentist
import TeamMemberTemplate from '../../layouts/TeamMemberTemplate.astro';
import BlurFade from '../../components/ui/BlurFade.astro';
---

<TeamMemberTemplate
  title="Jaclyn Altman, RDH | Registered Dental Hygienist | Central Dentist"
  description="Meet Jaclyn Altman, RDH - Registered Dental Hygienist with over 22 years of experience specializing in holistic dental care and myofunctional therapy at Central Dentist in Dallas, TX."
  memberName="Jaclyn Altman"
  credentials="RDH"
  role="Registered Dental Hygienist"
  imageUrl="/images/team/jaclyn-altman.jpg"
  breadcrumbs={[
    { label: 'Team', href: '/team' },
    { label: 'Jaclyn Altman', href: '/team/jaclyn-altman' }
  ]}
>
  <div slot="biography" class="bio-content">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 400; color: #006786; margin-bottom: 1rem;">About Jaclyn</h3>
    <p>Jaclyn Altman has been practicing dental hygiene for over 22 years. She holds advanced certifications in laser dentistry, and will soon have her earned certifications with IABDM and IAOMT. She has a special passion for holistic dental care and myofunctional therapy.</p>

    <p>A sought-after speaker, Jaclyn has presented at professional conventions on integrative approaches to oral health, sharing her expertise in blending traditional practices with holistic methods. Her dedication to continuing education and staying at the forefront of biological dentistry makes her an invaluable member of our team.</p>
  </div>

  <div slot="education" class="member-section bg-gray-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Certifications & Training</h3>
    <ul class="space-y-3 text-gray-600">
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Registered Dental Hygienist</strong> - 22+ years of clinical experience</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Laser Dentistry Certification</strong> - Advanced training in laser techniques</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>IABDM Certification</strong> - International Academy of Biological Dentistry and Medicine (in progress)</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>IAOMT Certification</strong> - International Academy of Oral Medicine and Toxicology (in progress)</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span><strong>Myofunctional Therapy Training</strong> - Specialized in orofacial myology</span>
      </li>
    </ul>
  </div>

  <div slot="specialties" class="member-section mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Areas of Expertise</h3>
    <ul class="space-y-3 text-gray-600">
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Holistic and biological dental hygiene practices</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Myofunctional therapy and orofacial wellness</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Laser-assisted periodontal therapy</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Integrative approaches to oral health</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Patient education and preventive care</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Professional speaking and dental hygiene education</span>
      </li>
    </ul>
  </div>

  <div slot="philosophy" class="member-section bg-green-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Personal Touch</h3>
    <p class="text-gray-700">Outside of her professional work, Jaclyn enjoys spending time with family, friends, and her two dogs. She is also an active member of her community choir and loves to scuba dive and knit. Her diverse interests reflect the balance and well-rounded approach she brings to patient care.</p>
  </div>

  <div slot="certifications" class="member-section bg-gray-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem; text-align: center;">Professional Affiliations</h3>
    <div class="flex flex-wrap justify-center gap-2">
      <span class="certification-badge">ADHA Member</span>
      <span class="certification-badge">Texas Dental Hygienists' Association</span>
      <span class="certification-badge">Academy of Laser Dentistry</span>
      <span class="certification-badge">IABDM (In Progress)</span>
      <span class="certification-badge">IAOMT (In Progress)</span>
      <span class="certification-badge">Professional Speaker</span>
    </div>
  </div>

  <section slot="cta" class="py-12 md:py-16" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <BlurFade delay={100} client:load>
        <h2 class="text-3xl md:text-4xl font-normal text-white mb-4"
            style="font-family: 'Playfair Display', serif;">
          Schedule Your Cleaning with Jaclyn
        </h2>
      </BlurFade>

      <BlurFade delay={200} client:load>
        <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
          Experience holistic dental hygiene with over two decades of expertise and compassionate care
        </p>
      </BlurFade>

      <BlurFade delay={300} client:load>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif;"
          >
            Book Your Cleaning
          </a>
          <a
            href="tel:214-368-0900"
            class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
            onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
            onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
          >
            <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Now: (214) 368-0900
          </a>
        </div>
      </BlurFade>
    </div>
  </section>

</TeamMemberTemplate>
