---
// Lakisha Merrick - Central Dentist
import TeamMemberTemplate from '../../layouts/TeamMemberTemplate.astro';
import BlurFade from '../../components/ui/BlurFade.astro';
---

<TeamMemberTemplate
  title="Lakisha Merrick | Chief Operating Officer | Central Dentist"
  description="Meet Lakisha Merrick, Chief Operating Officer at Central Dentist - a dynamic operational strategist and transformational leader guiding patient-centered dental care in Dallas, TX."
  memberName="Lakisha Merrick"
  role="Chief Operating Officer"
  imageUrl="/images/team/lakisha-merrick.jpg"
  breadcrumbs={[
    { label: 'Team', href: '/team' },
    { label: 'Lakisha Merrick', href: '/team/lakisha-merrick' }
  ]}
>
  <div slot="biography" class="bio-content">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 400; color: #006786; margin-bottom: 1rem;">About Lakisha</h3>
    <p>Lakisha Merrick is a dynamic operational strategist and transformational leader, now serving as the Chief Operating Officer for Central Dentist. Renowned for her sharp organizational insight and unwavering commitment to excellence, she brings a powerful blend of innovation, compassion, and business acumen to one of the region's most trusted dental networks.</p>

    <p>With a career defined by elevating patient experiences and optimizing large-scale healthcare operations, Lakisha is celebrated for turning vision into reality. Her leadership style—rooted in integrity, empowerment, and continuous improvement—has earned her a reputation as a catalyst for growth and a champion of high-performing teams.</p>

    <p>As COO, she guides Central Dentist into its next era of expansion, ensuring every clinic delivers top-tier care with efficiency, warmth, and purpose. Lakisha Merrick stands as a driving force behind a brighter, more patient-centered future in dental care.</p>
  </div>

  <div slot="specialties" class="member-section mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Leadership Focus Areas</h3>
    <ul class="space-y-3 text-gray-600">
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Strategic operational planning and clinic expansion</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Patient experience optimization and satisfaction</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Healthcare operations and workflow efficiency</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Team development and high-performance culture</span>
      </li>
      <li class="flex items-start">
        <span class="text-green-500 mr-2">•</span>
        <span>Quality assurance and continuous improvement initiatives</span>
      </li>
    </ul>
  </div>

  <div slot="philosophy" class="member-section bg-green-50 rounded-xl p-6 mt-8">
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 600; color: #2d3748; margin-bottom: 1.5rem;">Leadership Philosophy</h3>
    <p class="text-gray-700">Lakisha believes that exceptional dental care begins with exceptional operations. By fostering a culture of empowerment, integrity, and continuous improvement, she ensures that every patient interaction reflects the warmth and purpose that defines Central Dentist. Her vision is to create a seamless experience where patients feel cared for from the moment they walk through the door.</p>
  </div>

  <section slot="cta" class="py-12 md:py-16" style="background: linear-gradient(to bottom right, #0099ba, #006786);">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <BlurFade delay={100} client:load>
        <h2 class="text-3xl md:text-4xl font-normal text-white mb-4"
            style="font-family: 'Playfair Display', serif;">
          Experience the Central Dentist Difference
        </h2>
      </BlurFade>

      <BlurFade delay={200} client:load>
        <p class="text-lg text-white/90 mb-8" style="font-family: 'Geist', sans-serif;">
          Our team is dedicated to providing exceptional care with warmth and purpose
        </p>
      </BlurFade>

      <BlurFade delay={300} client:load>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="px-8 py-3 bg-gradient-to-r from-[#a6b443] to-[#c7cd85] text-white rounded-full font-semibold transition-all duration-300 hover:from-[#8fa339] hover:to-[#a6b443] hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif;"
          >
            Contact Us
          </a>
          <a
            href="tel:214-368-0900"
            class="px-8 py-3 bg-white border-2 rounded-full font-semibold transition-all duration-300 hover:shadow-lg inline-flex items-center justify-center"
            style="font-family: 'Playfair Display', serif; color: #0099ba; border-color: white;"
            onmouseover="this.style.backgroundColor='#006786'; this.style.color='white'; this.style.borderColor='#006786';"
            onmouseout="this.style.backgroundColor='white'; this.style.color='#0099ba'; this.style.borderColor='white';"
          >
            <svg aria-hidden="true" focusable="false" class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Now: (214) 368-0900
          </a>
        </div>
      </BlurFade>
    </div>
  </section>

</TeamMemberTemplate>
